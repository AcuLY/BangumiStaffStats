      "required": [
        "after",
        "authorityDigest",
        "before",
        "count",
        "endedEpochMs",
        "endedMonotonicNs",
        "firstDigest",
        "intervalSeconds",
        "lastDigest",
        "proofCommandId",
        "proofDigest",
        "samples",
        "startedEpochMs",
        "startedMonotonicNs",
        "status",
        "verificationProof"
      ],
      "type": "object"
