{
  "$defs": {
    "mountProjection": {
      "additionalProperties": false,
      "properties": {
        "bindCreateHostPath": { "const": false },
        "propagation": { "const": "rprivate" },
        "readOnly": { "type": "boolean" },
        "source": {
          "pattern": "^/srv/bgmss-ops-validation(?:/[A-Za-z0-9._-]+)+$",
          "type": "string"
        },
        "target": {
          "pattern": "^/(?:[A-Za-z0-9._-]+/?)+$",
          "type": "string"
        },
        "type": { "const": "bind" }
      },
      "required": [
        "bindCreateHostPath",
        "propagation",
        "readOnly",
        "source",
        "target",
        "type"
      ],
      "type": "object"
    },
    "portProjection": {
      "additionalProperties": false,
      "properties": {
        "hostIp": { "const": "127.0.0.1" },
        "protocol": { "const": "tcp" },
        "published": { "const": 19090 },
        "target": { "const": 8080 }
      },
      "required": [ "hostIp", "protocol", "published", "target" ],
      "type": "object"
    },
    "securityProjection": {
      "additionalProperties": false,
      "properties": {
        "schemaVersion": {
          "const": "operations-validation-security-projection-v1"
        },
        "services": {
          "items": {
            "$ref": "#/$defs/serviceSecurityProjection"
          },
          "maxItems": 3,
          "minItems": 3,
          "type": "array"
        }
      },
      "required": [ "schemaVersion", "services" ],
      "type": "object"
    },
    "serviceSecurityProjection": {
      "additionalProperties": false,
      "properties": {
        "capAdd": { "maxItems": 0, "type": "array" },
        "capDrop": {
          "items": { "type": "string" },
          "maxItems": 8,
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "command": {
          "items": {
            "maxLength": 4096,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 32,
          "minItems": 1,
          "type": "array"
        },
        "entrypoint": {
          "items": {
            "maxLength": 4096,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 8,
          "minItems": 1,
          "type": "array"
        },
        "environment": {
          "additionalProperties": {
            "maxLength": 4096,
            "type": "string"
          },
          "propertyNames": {
            "pattern": "^[A-Z][A-Z0-9_]{0,63}$"
          },
          "type": "object"
        },
        "image": {
          "format": "container-image-reference",
          "type": "string"
        },
        "init": { "const": true },
        "labels": {
          "additionalProperties": {
            "maxLength": 4096,
            "type": "string"
          },
          "maxProperties": 64,
          "minProperties": 3,
          "propertyNames": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
          },
          "type": "object"
        },
        "logging": {
          "additionalProperties": false,
          "properties": {
            "driver": { "const": "journald" },
            "options": {
              "additionalProperties": {
                "maxLength": 256,
                "minLength": 1,
                "type": "string"
              },
              "maxProperties": 4,
              "minProperties": 1,
              "type": "object"
            }
          },
          "required": [ "driver", "options" ],
          "type": "object"
        },
        "memoryBytes": {
          "maximum": 1610612736,
          "minimum": 536870912,
          "type": "integer"
        },
        "mounts": {
          "items": { "$ref": "#/$defs/mountProjection" },
          "maxItems": 3,
          "type": "array"
        },
        "nanoCpus": {
          "maximum": 1500000000,
          "minimum": 500000000,
          "type": "integer"
        },
        "networks": {
          "items": {
            "enum": [
              "bgmss_ops_validation_outbound",
              "bgmss_ops_validation_runtime"
            ],
            "type": "string"
          },
          "maxItems": 2,
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "maximumProcesses": {
          "maximum": 256,
          "minimum": 128,
          "type": "integer"
        },
        "ports": {
          "items": { "$ref": "#/$defs/portProjection" },
          "maxItems": 1,
          "type": "array"
        },
        "privileged": { "const": false },
        "readOnlyRootFilesystem": { "const": true },
        "restart": {
          "enum": [ "no", "unless-stopped" ],
          "type": "string"
        },
        "securityOptions": {
          "items": { "type": "string" },
          "maxItems": 4,
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "service": {
          "enum": [ "api", "prometheus", "updater" ],
          "type": "string"
        },
        "stopGracePeriodSeconds": { "const": 30 },
        "tmpfs": {
          "items": {
            "pattern": "^/[A-Za-z0-9._/-]+:rw,noexec,nosuid,nodev,size=[0-9]+m$",
            "type": "string"
          },
          "maxItems": 2,
          "type": "array",
          "uniqueItems": true
        },
        "user": { "const": "65532:65532" }
      },
      "required": [
        "capAdd",
        "capDrop",
        "command",
        "entrypoint",
        "environment",
        "image",
        "init",
        "labels",
        "logging",
        "maximumProcesses",
        "memoryBytes",
        "mounts",
        "nanoCpus",
        "networks",
        "ports",
        "privileged",
        "readOnlyRootFilesystem",
        "restart",
        "securityOptions",
        "service",
        "stopGracePeriodSeconds",
        "tmpfs",
        "user"
      ],
      "type": "object"
    },
    "continuousRuntimeIdentity": {
      "additionalProperties": false,
      "properties": {
        "containerId": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "imageReference": {
          "format": "container-image-reference",
          "type": "string"
        },
        "imageRuntimeId": {
          "format": "sha256",
          "type": "string"
        },
        "restartCount": {
          "maximum": 1000,
          "minimum": 0,
          "type": "integer"
        },
        "running": {
          "const": true
        },
        "securityDigest": {
          "format": "sha256",
          "type": "string"
        },
        "startDigest": {
          "format": "sha256",
          "type": "string"
