        "apiVersion": {
          "pattern": "^v(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)$",
          "type": "string"
        },
        "dataVersion": {
          "pattern": "^dv1-[0-9a-f]{64}$",
          "type": "string"
