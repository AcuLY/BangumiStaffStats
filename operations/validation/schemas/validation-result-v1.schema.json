            "inode": {
              "pattern": "^[1-9][0-9]*$",
              "type": "string"
            },
            "mode": {
              "const": "0644"
            }
          },
          "required": [ "digest", "inode", "mode" ],
          "type": "object"
        },
        "projections": {
          "additionalProperties": false,
          "properties": {
            "buildDigest": {
              "format": "sha256",
              "type": "string"
            },
            "metricsDigest": {
              "format": "sha256",
              "type": "string"
            },
            "prometheusDigest": {
              "format": "sha256",
              "type": "string"
            },
            "prometheusScrapeDigest": {
              "format": "sha256",
              "type": "string"
            },
            "queryResultDigest": {
              "format": "sha256",
              "type": "string"
            },
            "readyDigest": {
              "format": "sha256",
              "type": "string"
            },
            "typedQueryDigest": {
              "format": "sha256",
              "type": "string"
            }
          },
          "required": [
            "buildDigest",
            "metricsDigest",
            "prometheusDigest",
            "prometheusScrapeDigest",
            "queryResultDigest",
            "readyDigest",
            "typedQueryDigest"
          ],
          "type": "object"
        },
        "prometheus": {
          "$ref": "#/$defs/continuousRuntimeIdentity"
        }
      },
      "required": [
        "api",
        "apiRevision",
        "apiVersion",
        "dataVersion",
        "failureCode",
        "pointer",
        "projections",
        "prometheus"
      ],
      "type": "object"
