        "proofDigest": {
          "format": "sha256",
          "type": "string"
        },
        "startedEpochMs": {
          "maximum": 9007199254740991,
          "minimum": 1,
          "type": "integer"
        },
        "startedMonotonicNs": {
          "pattern": "^[1-9][0-9]{6,20}$",
          "type": "string"
