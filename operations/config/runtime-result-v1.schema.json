{
  "$id": "https://search.bgmss.fun/schemas/operations/runtime-result-v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "failure": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "pattern": "^[A-Z][A-Z0-9_]{0,63}$",
          "type": "string"
        },
        "phase": {
          "pattern": "^[a-z][a-z0-9-]{0,63}$",
          "type": "string"
        }
      },
      "required": [
        "code",
        "phase"
      ],
      "type": "object"
    },
    "identity": {
      "additionalProperties": false,
      "properties": {
        "appVersion": {
          "pattern": "^v(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)$",
          "type": [
            "string",
            "null"
          ]
        },
        "dataVersion": {
          "pattern": "^dv1-[0-9a-f]{64}$",
          "type": [
            "string",
            "null"
          ]
        },
        "manifestDigest": {
          "format": "sha256",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "appVersion",
        "dataVersion",
        "manifestDigest"
      ],
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "action": {
      "enum": [
        "check",
        "cleanup",
        "install",
        "preflight",
        "rollback-app",
        "rollback-data",
        "update"
      ],
      "type": "string"
    },
    "current": {
      "$ref": "#/$defs/identity"
    },
    "durationSeconds": {
      "maximum": 21600,
      "minimum": 0,
      "type": "integer"
    },
    "primary": {
      "anyOf": [
        {
          "$ref": "#/$defs/failure"
        },
        {
          "type": "null"
        }
      ]
    },
    "previous": {
      "$ref": "#/$defs/identity"
    },
    "runId": {
      "pattern": "^run-[0-9a-f]{32}$",
      "type": "string"
    },
    "schemaVersion": {
      "const": "runtime-result-v1",
      "type": "string"
    },
    "secondary": {
      "items": {
        "$ref": "#/$defs/failure"
      },
      "maxItems": 8,
      "type": "array"
    },
    "status": {
      "enum": [
        "failed",
        "manual-recovery",
        "no-change",
        "succeeded"
      ],
      "type": "string"
    }
  },
  "required": [
    "action",
    "current",
    "durationSeconds",
    "previous",
    "primary",
    "runId",
    "schemaVersion",
    "secondary",
    "status"
  ],
  "type": "object"
}
