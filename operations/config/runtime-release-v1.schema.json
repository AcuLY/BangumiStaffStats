{
  "$id": "https://search.bgmss.fun/schemas/operations/runtime-release-v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "apiImage": {
      "format": "container-image-reference",
      "pattern": "@sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "appRevision": {
      "format": "git-oid",
      "type": "string"
    },
    "appVersion": {
      "pattern": "^v(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)$",
      "type": "string"
    },
    "archiveSmokeDigest": {
      "format": "sha256",
      "type": "string"
    },
    "commonCommit": {
      "format": "git-oid",
      "type": "string"
    },
    "manifestDigest": {
      "format": "sha256",
      "type": "string"
    },
    "schemaVersion": {
      "const": "runtime-release-v1",
      "type": "string"
    },
    "updaterImage": {
      "format": "container-image-reference",
      "pattern": "@sha256:[0-9a-f]{64}$",
      "type": "string"
    }
  },
  "required": [
    "apiImage",
    "appRevision",
    "appVersion",
    "archiveSmokeDigest",
    "commonCommit",
    "manifestDigest",
    "schemaVersion",
    "updaterImage"
  ],
  "type": "object"
}
