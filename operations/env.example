# Copy values into root-managed arguments passed to operations/bin/deploy.
# The generated current.env contains exactly these keys.
COMPOSE_PROJECT_NAME=bgmss-v2
BGMSS_ROOT=/srv/bgmss-v2
BGMSS_API_IMAGE=localhost/bgmss-backend-api:REPLACE_WITH_REVISION-amd64
BGMSS_UPDATER_IMAGE=localhost/bgmss-updater-artifact:REPLACE_WITH_REVISION-amd64
BGMSS_PROMETHEUS_IMAGE=prom/prometheus:v3.13.1-distroless@sha256:214f8427c8fba80c327bb94a75feb802ae12f2d6ca30812aa6e7d22f09bbea80
BGMSS_API_PORT=18080
BGMSS_PROMETHEUS_PORT=19090
# Optional validation/low-memory overrides; production defaults are in compose.yaml.
# BGMSS_API_MEM_LIMIT=768m
# BGMSS_API_GOMEMLIMIT=512MiB
# BGMSS_PROMETHEUS_MEM_LIMIT=192m
