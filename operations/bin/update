#!/usr/bin/env bash
set -Eeuo pipefail
IFS=$'\n\t'

script_root=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)
# shellcheck source=../lib/common.sh
source "$script_root/../lib/common.sh"

[[ $# -eq 2 && "$1" == --root ]] ||
  die "usage: update --root ABS"
root=$2
for command in curl docker flock jq realpath sha256sum; do require_command "$command"; done
require_root_user
require_root_layout "$root"
acquire_state_lock "$root"

old_pointer=$(mktemp "$root/data/.previous-pointer.XXXXXX")
cp --preserve=mode,ownership -- "$root/data/current.json" "$old_pointer"
old_version=$(pointer_data_version "$old_pointer")

compose "$root" run --rm updater
status="$root/data/update-status.json"
new_version=$(jq -er '
  .last_attempt
  | select(.status == "published" or .status == "no-change")
  | .dataVersion
  | select(type == "string" and test("^dv1-[0-9a-f]{64}$"))
' "$status")
if [[ "$new_version" == "$old_version" ]]; then
  rm -f -- "$old_pointer"
  log "updater reported no change: $old_version"
  exit 0
fi

version_root="$root/data/versions/$new_version"
[[ -d "$version_root" && ! -L "$version_root" ]] || die "published version is absent"
[[ -f "$version_root/manifest.json" && -f "$version_root/bangumi.sqlite" ]] ||
  die "published version is incomplete"
manifest_digest="sha256:$(sha256sum "$version_root/manifest.json" | awk '{print $1}')"
candidate=$(mktemp "$root/data/.candidate-pointer.XXXXXX")
printf '{"pointerSchemaVersion":1,"dataVersion":"%s","manifestDigest":"%s"}\n' \
  "$new_version" "$manifest_digest" >"$candidate"
chmod 0640 "$candidate"
chown 65532:65532 "$candidate"

restore_data() {
  local failed=$?
  trap - ERR
  log "new Archive did not become ready; restoring previous pointer"
  atomic_copy "$old_pointer" "$root/data/current.json"
  if ! restart_and_wait "$root" "$old_version"; then
    die "new Archive failed and previous Archive did not recover"
  fi
  rm -f -- "$candidate" "$old_pointer"
  exit "$failed"
}
trap restore_data ERR
mv -fT -- "$candidate" "$root/data/current.json"
restart_and_wait "$root" "$new_version"
atomic_copy "$old_pointer" "$root/data/previous.json"
trap - ERR
rm -f -- "$old_pointer"
log "activated Archive $new_version"
