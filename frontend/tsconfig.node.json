{
  "compilerOptions": {
    "composite": true,
    "tsBuildInfoFile": "./.tmp/tsconfig.node.tsbuildinfo",
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2023"
    ],
    "strict": true,
    "noEmit": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": false,
    "types": [
      "node"
    ]
  },
  "include": [
    "vite.config.ts"
  ]
}
