{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bangumi-staff-stats.invalid/schemas/development-acceptance-oracle-exceptions-v1.json",
  "title": "Closed oracle exception registry v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "oracleRevision",
    "screenshotThreshold",
    "entries"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "oracleRevision": {
      "const": "644b7748674e553f863d0ffd61d029f86fdc0717"
    },
    "screenshotThreshold": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "maxDifferentPixelRatio",
        "maxColorDelta"
      ],
      "properties": {
        "maxDifferentPixelRatio": {
          "const": 0.002
        },
        "maxColorDelta": {
          "const": 8
        }
      }
    },
    "entries": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/entry"
      }
    }
  },
  "$defs": {
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "classification",
        "route",
        "state",
        "selector",
        "properties",
        "authority"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9.-]{2,95}$"
        },
        "classification": {
          "type": "string",
          "enum": [
            "approved-addition",
            "dynamic-data"
          ]
        },
        "route": {
          "type": "string",
          "enum": [
            "/",
            "/ranking",
            "/co-star"
          ]
        },
        "state": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{1,63}$"
        },
        "selector": {
          "type": "string",
          "minLength": 2,
          "maxLength": 256
        },
        "properties": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "text-content",
              "content-pixels",
              "image-source"
            ]
          }
        },
        "authority": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "heading"
          ],
          "properties": {
            "path": {
              "type": "string",
              "pattern": "^(?:PRODUCT\\.md|DESIGN\\.md|openspec/specs/[a-z0-9-]+/spec\\.md)$"
            },
            "heading": {
              "type": "string",
              "minLength": 2,
              "maxLength": 200
            }
          }
        }
      }
    }
  }
}
