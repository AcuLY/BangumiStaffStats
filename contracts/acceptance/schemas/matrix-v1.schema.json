{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bangumi-staff-stats.invalid/schemas/development-acceptance-matrix-v1.json",
  "title": "Closed development acceptance matrix v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "matrixVersion",
    "cells"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "matrixVersion": {
      "const": "development-acceptance-v1"
    },
    "cells": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/cell"
      }
    }
  },
  "$defs": {
    "cell": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "phase",
        "owner",
        "kind",
        "action",
        "requires",
        "timeoutMs",
        "evidence"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9.-]{2,95}$"
        },
        "phase": {
          "type": "string",
          "enum": [
            "admission",
            "owner-gates",
            "artifacts",
            "archive-runtime",
            "api",
            "browser-oracle",
            "performance",
            "residue"
          ]
        },
        "owner": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{2,95}$"
        },
        "kind": {
          "type": "string",
          "enum": [
            "attestation",
            "command",
            "scenario",
            "measurement",
            "seal"
          ]
        },
        "action": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9:-]{2,127}$"
        },
        "requires": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9.-]{2,95}$"
          }
        },
        "timeoutMs": {
          "type": "integer",
          "minimum": 100,
          "maximum": 7200000
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-zA-Z0-9]*$"
          }
        }
      }
    }
  }
}
