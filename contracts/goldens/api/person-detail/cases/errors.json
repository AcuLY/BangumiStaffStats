{
  "schemaVersion": 1,
  "kind": "person-detail-error-cases",
  "cases": [
    {
      "id": "refresh-field-rejected",
      "requestSchemaValid": false,
      "request": {
        "method": "POST",
        "path": "/api/v1/person-detail",
        "body": {
          "query": {
            "scope": "personal",
            "uid": "Alice",
            "collectionStatuses": [
              "completed"
            ],
            "subjectType": "anime",
            "positionKeys": [
              "staff:anime:2"
            ]
          },
          "input": {
            "personId": 100
          },
          "refreshCollection": true
        }
      },
      "expected": {
        "status": 400,
        "headers": {
          "Cache-Control": "private, no-store",
          "Content-Type": "application/json",
          "X-Request-ID": "req-detail-refresh"
        },
        "body": {
          "error": {
            "code": "INVALID_REQUEST",
            "message": "The request contains an unknown field.",
            "retryable": false,
            "fieldErrors": {
              "/refreshCollection": [
                "UNKNOWN_FIELD"
              ]
            }
          },
          "meta": {
            "requestId": "req-detail-refresh"
          }
        }
      }
    },
