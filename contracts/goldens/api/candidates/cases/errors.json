          "X-Request-ID": "req-candidates-selected-state"
        },
        "body": {
          "error": {
            "code": "INVALID_REQUEST",
            "message": "The request contains an unknown field.",
            "retryable": false,
            "fieldErrors": {
              "/input/selectedPersonIds": [
                "UNKNOWN_FIELD"
              ]
            }
          },
          "meta": {
            "requestId": "req-candidates-selected-state"
          }
        }
      }
    },
    {
      "id": "wrong-method-rejected",
      "requestSchemaValid": true,
      "request": {
        "method": "GET",
        "body": {
          "query": {
            "scope": "global",
            "subjectType": "anime",
            "positionKeys": [
              "staff:anime:2"
            ]
          },
          "input": {
            "positionKey": "staff:anime:2"
          }
        }
      },
      "expected": {
        "status": 405,
        "headers": {
          "Allow": "POST",
          "Cache-Control": "private, no-store",
          "Content-Type": "application/json",
          "X-Request-ID": "req-candidates-method"
        },
        "body": {
          "error": {
            "code": "INVALID_REQUEST",
            "message": "Only POST is supported.",
            "retryable": false,
            "fieldErrors": {}
          },
          "meta": {
            "requestId": "req-candidates-method"
          }
        }
      }
    },
    {
      "id": "store-not-ready",
      "requestSchemaValid": true,
      "request": {
        "method": "POST",
        "body": {
          "query": {
            "scope": "global",
            "subjectType": "anime",
            "positionKeys": [
              "staff:anime:2"
            ]
          },
          "input": {
            "positionKey": "staff:anime:2"
          }
        }
      },
      "expected": {
        "status": 503,
        "headers": {
          "Cache-Control": "private, no-store",
          "Content-Type": "application/json",
          "Retry-After": "1",
          "X-Request-ID": "req-candidates-not-ready"
        },
        "body": {
          "error": {
            "code": "NOT_READY",
            "message": "The immutable archive is not ready.",
            "retryable": true,
            "fieldErrors": {}
          },
          "meta": {
            "requestId": "req-candidates-not-ready"
          }
        }
      }
    },
    {
      "id": "deadline-before-commit",
      "requestSchemaValid": true,
      "request": {
        "method": "POST",
        "body": {
          "query": {
            "scope": "global",
            "subjectType": "anime",
            "positionKeys": [
              "staff:anime:2"
            ]
          },
          "input": {
            "positionKey": "staff:anime:2"
          }
        }
      },
      "expected": {
        "status": 504,
        "headers": {
          "Cache-Control": "private, no-store",
          "Content-Type": "application/json",
          "X-Request-ID": "req-candidates-timeout"
        },
        "body": {
          "error": {
            "code": "UPSTREAM_TIMEOUT",
            "message": "The candidate request timed out.",
            "retryable": true,
            "fieldErrors": {}
          },
          "meta": {
            "requestId": "req-candidates-timeout"
          }
        }
      }
    }
  ]
}
