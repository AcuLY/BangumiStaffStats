    {
      "id": "co-star-partners-share",
      "path": "/co-star",
      "queryCase": "personal-normalization",
      "payload": {
        "query": {
          "scope": "personal",
          "uid": "Alice",
          "collectionStatuses": [
            "completed",
            "in_progress",
            "dropped"
          ],
          "subjectType": "anime",
          "positionKeys": [
            "staff:anime:2",
            "cast:anime:all"
          ],
          "includeNSFW": false,
          "mergeSeries": false,
          "filters": {
            "subjectDate": {
              "min": "2000-01",
              "max": "2025-12"
            },
            "collectionUpdatedAt": {
              "min": "2020-02"
            },
            "personalScore": {
              "min": 0,
              "max": 10
            },
            "globalScore": {
              "min": 6.5
            },
            "scoreDifference": {
              "min": -10,
              "max": 10
            },
            "ratingCount": {
              "min": 0,
              "max": 9007199254740991
            },
            "tags": {
              "include": [
                {
                  "anyOf": [
                    "sf",
                    "strasse"
                  ]
                },
                {
                  "anyOf": [
                    "日常"
                  ]
                }
              ],
              "exclude": [
                {
                  "allOf": [
                    "ドラマ"
                  ]
                }
              ]
            }
          }
        },
        "workspace": {
          "kind": "co-star",
          "state": "partners",
          "candidates": {
            "input": {
              "positionKey": "staff:anime:2"
            },
            "view": {
              "search": "",
              "sort": "count",
              "order": "desc",
              "page": 1,
              "pageSize": 10
            }
          },
          "partners": {
            "input": {
              "source": {
                "personId": 1,
                "positionKeys": [
                  "staff:anime:2",
                  "cast:anime:all"
                ]
              },
              "candidatePositionKey": "cast:anime:all"
            },
            "view": {
              "search": "",
              "sort": "preference",
              "order": "desc",
              "page": 1,
              "pageSize": 10
            }
          }
        }
