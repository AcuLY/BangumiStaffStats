      "expectedCanonical": "{\"query\":{\"collectionStatuses\":[\"completed\",\"in_progress\",\"dropped\"],\"filters\":{\"collectionUpdatedAt\":{\"min\":\"2020-02\"},\"globalScore\":{\"min\":6.5},\"personalScore\":{\"max\":10,\"min\":0},\"ratingCount\":{\"max\":9007199254740991,\"min\":0},\"scoreDifference\":{\"max\":10,\"min\":-10},\"subjectDate\":{\"max\":\"2025-12\",\"min\":\"2000-01\"},\"tags\":{\"exclude\":[{\"allOf\":[\"ドラマ\"]}],\"include\":[{\"anyOf\":[\"sf\",\"strasse\"]},{\"anyOf\":[\"日常\"]}]}},\"includeNSFW\":false,\"mergeSeries\":false,\"positionKeys\":[\"staff:anime:2\",\"cast:anime:all\"],\"scope\":\"personal\",\"subjectType\":\"anime\",\"uid\":\"Alice\"},\"workspace\":{\"candidates\":{\"input\":{\"positionKey\":\"staff:anime:2\"},\"view\":{\"order\":\"desc\",\"page\":1,\"pageSize\":10,\"search\":\"\",\"sort\":\"count\"}},\"kind\":\"co-star\",\"partners\":{\"input\":{\"candidatePositionKey\":\"cast:anime:all\",\"source\":{\"personId\":1,\"positionKeys\":[\"staff:anime:2\",\"cast:anime:all\"]}},\"view\":{\"order\":\"desc\",\"page\":1,\"pageSize\":10,\"search\":\"\",\"sort\":\"preference\"}},\"state\":\"partners\"}}",
      "expectedFragment": "/co-star#q=v1."
    },
