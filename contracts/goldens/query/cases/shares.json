                  ]
                }
              ],
              "exclude": [
                {
                  "allOf": [
                    "ova",
                    "special"
                  ]
                }
              ]
            }
          }
        },
        "workspace": {
          "kind": "co-star",
          "state": "empty",
          "candidates": {
            "input": {
              "positionKey": "staffset:anime:core-creators"
            },
            "view": {
              "search": "",
              "sort": "count",
              "order": "desc",
              "page": 1,
              "pageSize": 10
            }
          }
        }
