      "authorityRefs": ["product-statistics", "dr-rating-001"],
      "coverage": ["average-floor", "overall-positive-half-up"],
      "input": {
        "mode": "subject",
        "units": [
          {"unitId": 211, "rating": 1},
          {"unitId": 212, "rating": 2},
          {"unitId": 213, "rating": 2}
