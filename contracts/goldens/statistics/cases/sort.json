      "behaviorClass": "INTENTIONAL_DELTA",
      "authorityRefs": ["product-statistics", "dr-sort-001", "dr-candidate-001"],
      "coverage": ["sort-person-count", "sort-both-directions", "sort-complete-ties", "sort-shuffled-input", "sort-page-boundary", "sort-entity-set-preservation"],
      "input": {
        "profile": "person-count",
        "entries": [
          {"personId": 1, "count": 5, "averageHundredths": 800, "validRatingCount": 3},
          {"personId": 2, "count": 2, "averageHundredths": null, "validRatingCount": 0},
          {"personId": 3, "count": 5, "averageHundredths": 800, "validRatingCount": 3},
          {"personId": 4, "count": 5, "averageHundredths": 900, "validRatingCount": 1},
          {"personId": 5, "count": 2, "averageHundredths": 700, "validRatingCount": 2}
        ],
        "shuffledInputIds": [[5, 3, 1, 4, 2], [2, 4, 1, 5, 3]],
        "pageSize": 2
      },
      "expected": {
        "descendingIds": [4, 1, 3, 5, 2],
        "ascendingIds": [5, 2, 4, 1, 3],
        "descendingPages": [[4, 1], [3, 5], [2]]
      }
    },
