{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bangumi-staff-stats.invalid/schemas/update-status/golden-index-v1.json",
  "title": "Closed updater status golden index v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "indexSchemaVersion",
    "algorithm",
    "entries"
  ],
  "properties": {
    "indexSchemaVersion": {
      "type": "integer",
      "const": 1
    },
    "algorithm": {
      "type": "string",
      "const": "bgmss-update-status-golden-index-v1"
    },
    "entries": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "sha256",
          "caseId",
          "caseKind",
          "outcome"
        ],
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^cases/[a-z0-9]+(?:-[a-z0-9]+)*\\.json$"
          },
          "sha256": {
            "type": "string",
            "minLength": 64,
            "maxLength": 64,
            "pattern": "^[0-9a-f]{64}$"
          },
          "caseId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "caseKind": {
            "type": "string",
            "enum": [
              "status-document",
              "invalid-mutations"
            ]
          },
          "outcome": {
            "type": "string",
            "enum": [
              "VALID",
              "INVALID"
            ]
          }
        }
      }
    }
  }
}
