{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bangumi-staff-stats.local/schemas/query/query-digest-projection-v1.schema.json",
  "title": "QueryDigestProjectionV1",
  "oneOf": [
    {
      "$ref": "#/$defs/PersonalProjectionV1"
    },
    {
      "$ref": "#/$defs/GlobalProjectionV1"
    }
  ],
  "$defs": {
    "PersonalProjectionV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scope",
        "collectionStatuses",
        "subjectType",
        "positionKeys",
        "includeNSFW",
        "mergeSeries"
      ],
      "properties": {
        "scope": {
          "const": "personal"
        },
        "collectionStatuses": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "uniqueItems": true,
          "items": {
            "$ref": "shared-query-v1.schema.json#/$defs/CollectionStatusV1"
          }
        },
        "subjectType": {
          "$ref": "shared-query-v1.schema.json#/$defs/SubjectTypeV1"
        },
        "positionKeys": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "shared-query-v1.schema.json#/$defs/PositionKeyV1"
          }
        },
        "includeNSFW": {
          "type": "boolean"
        },
        "mergeSeries": {
          "type": "boolean"
        },
        "filters": {
          "$ref": "effective-query-v1.schema.json#/$defs/EffectivePersonalFiltersV1"
        }
      }
    },
    "GlobalProjectionV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scope",
        "subjectType",
        "positionKeys",
        "includeNSFW",
        "mergeSeries"
      ],
      "properties": {
        "scope": {
          "const": "global"
        },
        "subjectType": {
          "$ref": "shared-query-v1.schema.json#/$defs/SubjectTypeV1"
        },
        "positionKeys": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "shared-query-v1.schema.json#/$defs/PositionKeyV1"
          }
        },
        "includeNSFW": {
          "type": "boolean"
        },
        "mergeSeries": {
          "type": "boolean"
        },
        "filters": {
          "$ref": "effective-query-v1.schema.json#/$defs/EffectiveCommonFiltersV1"
        }
      }
    }
  }
}
