{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bangumi-staff-stats.local/schemas/query/shared-query-v1.schema.json",
  "title": "SharedQueryV1",
  "oneOf": [
    {
      "$ref": "#/$defs/PersonalSharedQueryV1"
    },
    {
      "$ref": "#/$defs/GlobalSharedQueryV1"
    }
  ],
  "$defs": {
    "JsonSafePositiveIntegerV1": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "SubjectTypeV1": {
      "type": "string",
      "enum": [
        "book",
        "anime",
        "music",
        "game",
        "real"
      ]
    },
    "PositionKeyV1": {
      "type": "string",
      "minLength": 1,
      "maxLength": 96,
      "oneOf": [
        {
          "pattern": "^staff:(book|anime|music|game|real):[1-9][0-9]*$"
        },
        {
          "pattern": "^cast:(anime|game):(main|all)$"
        },
        {
          "pattern": "^staffset:(book|anime|music|game|real):[a-z0-9]+(?:-[a-z0-9]+)*$"
        }
      ]
    },
    "CollectionStatusV1": {
      "type": "string",
      "enum": [
        "completed",
        "in_progress",
        "on_hold",
        "dropped"
      ]
    },
    "MonthV1": {
      "type": "string",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])$"
    },
    "MonthRangeV1": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "min": {
          "$ref": "#/$defs/MonthV1"
        },
        "max": {
          "$ref": "#/$defs/MonthV1"
        }
      }
    },
    "ScoreRangeV1": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "min": {
          "type": "number",
          "minimum": 0,
          "maximum": 10
        },
        "max": {
          "type": "number",
          "minimum": 0,
          "maximum": 10
        }
      }
    },
    "ScoreDifferenceRangeV1": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "min": {
          "type": "number",
          "minimum": -10,
          "maximum": 10
        },
        "max": {
          "type": "number",
          "minimum": -10,
          "maximum": 10
        }
      }
    },
    "RatingCountRangeV1": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "min": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "max": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      }
    },
    "TagTokenInputV1": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "TagIncludeGroupInputV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "anyOf"
      ],
      "properties": {
        "anyOf": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": {
            "$ref": "#/$defs/TagTokenInputV1"
          }
        }
      }
    },
    "TagExcludeGroupInputV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "allOf"
      ],
      "properties": {
        "allOf": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": {
            "$ref": "#/$defs/TagTokenInputV1"
          }
        }
      }
    },
    "TagFilterInputV1": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "include": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/TagIncludeGroupInputV1"
          }
        },
        "exclude": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/TagExcludeGroupInputV1"
          }
        }
      }
    },
    "CommonFiltersInputV1": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "subjectDate": {
          "$ref": "#/$defs/MonthRangeV1"
        },
        "globalScore": {
          "$ref": "#/$defs/ScoreRangeV1"
        },
        "ratingCount": {
          "$ref": "#/$defs/RatingCountRangeV1"
        },
        "tags": {
          "$ref": "#/$defs/TagFilterInputV1"
        }
      }
    },
    "PersonalFiltersInputV1": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "subjectDate": {
          "$ref": "#/$defs/MonthRangeV1"
        },
        "collectionUpdatedAt": {
          "$ref": "#/$defs/MonthRangeV1"
        },
        "personalScore": {
          "$ref": "#/$defs/ScoreRangeV1"
        },
        "globalScore": {
          "$ref": "#/$defs/ScoreRangeV1"
        },
        "scoreDifference": {
          "$ref": "#/$defs/ScoreDifferenceRangeV1"
        },
        "ratingCount": {
          "$ref": "#/$defs/RatingCountRangeV1"
        },
        "tags": {
          "$ref": "#/$defs/TagFilterInputV1"
        }
      }
    },
    "PersonalSharedQueryV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scope",
        "uid",
        "collectionStatuses",
        "subjectType",
        "positionKeys"
      ],
      "properties": {
        "scope": {
          "const": "personal"
        },
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "collectionStatuses": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": {
            "$ref": "#/$defs/CollectionStatusV1"
          }
        },
        "subjectType": {
          "$ref": "#/$defs/SubjectTypeV1"
        },
        "positionKeys": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/PositionKeyV1"
          }
        },
        "includeNSFW": {
          "type": "boolean",
          "default": false
        },
        "mergeSeries": {
          "type": "boolean",
          "default": false
        },
        "filters": {
          "$ref": "#/$defs/PersonalFiltersInputV1"
        }
      }
    },
    "GlobalSharedQueryV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scope",
        "subjectType",
        "positionKeys"
      ],
      "properties": {
        "scope": {
          "const": "global"
        },
        "subjectType": {
          "$ref": "#/$defs/SubjectTypeV1"
        },
        "positionKeys": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/PositionKeyV1"
          }
        },
        "includeNSFW": {
          "type": "boolean",
          "default": false
        },
        "mergeSeries": {
          "type": "boolean",
          "default": false
        },
        "filters": {
          "$ref": "#/$defs/CommonFiltersInputV1"
        }
      }
    }
  }
}
