{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bangumi-staff-stats.local/schemas/partners/success-envelope-v1.schema.json",
  "title": "PartnersSuccessEnvelopeV1",
  "oneOf": [
    {
      "$ref": "#/$defs/PersonalPartnersSuccessEnvelopeV1"
    },
    {
      "$ref": "#/$defs/GlobalPartnersSuccessEnvelopeV1"
    }
  ],
  "$defs": {
    "JsonSafeNonNegativeIntegerV1": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "JsonSafePositiveIntegerV1": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "HundredthsV1": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1000
    },
    "OpaqueIdentifierV1": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[^\\u0000-\\u001F\\u007F]+$"
    },
    "DataVersionV1": {
      "type": "string",
      "minLength": 68,
      "maxLength": 68,
      "pattern": "^dv1-[0-9a-f]{64}$"
    },
    "PositionKeyV1": {
      "$ref": "../query/shared-query-v1.schema.json#/$defs/PositionKeyV1"
    },
    "CanonicalIntegerStringV1": {
      "type": "string",
      "pattern": "^(?:0|-?[1-9][0-9]*)$",
      "maxLength": 4096
    },
    "CanonicalPositiveIntegerStringV1": {
      "type": "string",
      "pattern": "^[1-9][0-9]*$",
      "maxLength": 4096
    },
    "CanonicalNonNegativeIntegerStringV1": {
      "type": "string",
      "pattern": "^(?:0|[1-9][0-9]*)$",
      "maxLength": 4096
    },
    "RationalV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "numerator",
        "denominator"
      ],
      "properties": {
        "numerator": {
          "$ref": "#/$defs/CanonicalIntegerStringV1"
        },
        "denominator": {
          "$ref": "#/$defs/CanonicalPositiveIntegerStringV1"
        }
      }
    },
    "NonNegativeRationalV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "numerator",
        "denominator"
      ],
      "properties": {
        "numerator": {
          "$ref": "#/$defs/CanonicalNonNegativeIntegerStringV1"
        },
        "denominator": {
          "$ref": "#/$defs/CanonicalPositiveIntegerStringV1"
        }
      }
    },
    "PersonReferenceV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "nameCN"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/JsonSafePositiveIntegerV1"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "nameCN": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 4096
        }
      }
    },
    "SourceMetricsV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "workCount",
        "ratedWorkCount",
        "average"
      ],
      "properties": {
        "workCount": {
          "$ref": "#/$defs/JsonSafePositiveIntegerV1"
        },
        "ratedWorkCount": {
          "$ref": "#/$defs/JsonSafeNonNegativeIntegerV1"
        },
        "average": {
          "oneOf": [
            {
              "$ref": "#/$defs/HundredthsV1"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "PartnerMetricsV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "workCount",
        "ratedWorkCount",
        "average",
        "overall"
      ],
      "properties": {
        "workCount": {
          "$ref": "#/$defs/JsonSafePositiveIntegerV1"
        },
        "ratedWorkCount": {
          "$ref": "#/$defs/JsonSafeNonNegativeIntegerV1"
        },
        "average": {
          "oneOf": [
            {
              "$ref": "#/$defs/HundredthsV1"
            },
            {
              "type": "null"
            }
          ]
        },
        "overall": {
          "oneOf": [
            {
              "$ref": "#/$defs/HundredthsV1"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "PreferenceV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "comparableCount",
        "comparableSeriesCount",
        "effectiveEvidence",
        "mean",
        "evidenceWeight",
        "score"
      ],
      "properties": {
        "comparableCount": {
          "$ref": "#/$defs/JsonSafeNonNegativeIntegerV1"
        },
        "comparableSeriesCount": {
          "$ref": "#/$defs/JsonSafeNonNegativeIntegerV1"
        },
        "effectiveEvidence": {
          "$ref": "#/$defs/JsonSafeNonNegativeIntegerV1"
        },
        "mean": {
          "oneOf": [
            {
              "$ref": "#/$defs/RationalV1"
            },
            {
              "type": "null"
            }
          ]
        },
        "evidenceWeight": {
          "$ref": "#/$defs/NonNegativeRationalV1"
        },
        "score": {
          "oneOf": [
            {
              "$ref": "#/$defs/RationalV1"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "SourceV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "person",
        "positionKeys",
        "metrics"
      ],
      "properties": {
        "person": {
          "$ref": "#/$defs/PersonReferenceV1"
        },
        "positionKeys": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/PositionKeyV1"
          }
        },
        "metrics": {
          "$ref": "#/$defs/SourceMetricsV1"
        }
      }
    },
    "GlobalPartnerCoreV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "person",
        "positionKeys",
        "metrics"
      ],
      "properties": {
        "person": {
          "$ref": "#/$defs/PersonReferenceV1"
        },
        "positionKeys": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/PositionKeyV1"
          }
        },
        "metrics": {
          "$ref": "#/$defs/PartnerMetricsV1"
        }
      }
    },
    "PersonalPartnerCoreV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "person",
        "positionKeys",
        "metrics",
        "preference"
      ],
      "properties": {
        "person": {
          "$ref": "#/$defs/PersonReferenceV1"
        },
        "positionKeys": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/PositionKeyV1"
          }
        },
        "metrics": {
          "$ref": "#/$defs/PartnerMetricsV1"
        },
        "preference": {
          "$ref": "#/$defs/PreferenceV1"
        }
      }
    },
    "GlobalPartnerItemV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rank",
        "person",
        "positionKeys",
        "metrics"
      ],
      "properties": {
        "rank": {
          "$ref": "#/$defs/JsonSafePositiveIntegerV1"
        },
        "person": {
          "$ref": "#/$defs/PersonReferenceV1"
        },
        "positionKeys": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/PositionKeyV1"
          }
        },
        "metrics": {
          "$ref": "#/$defs/PartnerMetricsV1"
        }
      }
    },
    "PersonalPartnerItemV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rank",
        "person",
        "positionKeys",
        "metrics",
        "preference"
      ],
      "properties": {
        "rank": {
          "$ref": "#/$defs/JsonSafePositiveIntegerV1"
        },
        "person": {
          "$ref": "#/$defs/PersonReferenceV1"
        },
        "positionKeys": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/PositionKeyV1"
          }
        },
        "metrics": {
          "$ref": "#/$defs/PartnerMetricsV1"
        },
        "preference": {
          "$ref": "#/$defs/PreferenceV1"
        }
      }
    },
    "CountGlobalLeaderV1": {
      "type": "object",
      "$ref": "#/$defs/GlobalLeaderV1",
      "properties": {
        "metric": {
          "const": "count"
        }
      }
    },
    "AverageGlobalLeaderV1": {
      "type": "object",
      "$ref": "#/$defs/GlobalLeaderV1",
      "properties": {
        "metric": {
          "const": "average"
        }
      }
    },
    "OverallGlobalLeaderV1": {
      "type": "object",
      "$ref": "#/$defs/GlobalLeaderV1",
      "properties": {
        "metric": {
          "const": "overall"
        }
      }
    },
    "GlobalLeaderV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "metric",
        "item"
      ],
      "properties": {
        "metric": {
          "type": "string",
          "enum": [
            "count",
            "average",
            "overall"
          ]
        },
        "item": {
          "oneOf": [
            {
              "$ref": "#/$defs/GlobalPartnerCoreV1"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "CountPersonalLeaderV1": {
      "type": "object",
      "$ref": "#/$defs/PersonalLeaderV1",
      "properties": {
        "metric": {
          "const": "count"
        }
      }
    },
    "AveragePersonalLeaderV1": {
      "type": "object",
      "$ref": "#/$defs/PersonalLeaderV1",
      "properties": {
        "metric": {
          "const": "average"
        }
      }
    },
    "OverallPersonalLeaderV1": {
      "type": "object",
      "$ref": "#/$defs/PersonalLeaderV1",
      "properties": {
        "metric": {
          "const": "overall"
        }
      }
    },
    "PreferencePersonalLeaderV1": {
      "type": "object",
      "$ref": "#/$defs/PersonalLeaderV1",
      "properties": {
        "metric": {
          "const": "preference"
        }
      }
    },
    "PersonalLeaderV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "metric",
        "item"
      ],
      "properties": {
        "metric": {
          "type": "string",
          "enum": [
            "count",
            "average",
            "overall",
            "preference"
          ]
        },
        "item": {
          "oneOf": [
            {
              "$ref": "#/$defs/PersonalPartnerCoreV1"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "GlobalSummaryV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "partnerCount",
        "leaders"
      ],
      "properties": {
        "partnerCount": {
          "$ref": "#/$defs/JsonSafeNonNegativeIntegerV1"
        },
        "leaders": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "prefixItems": [
            {
              "$ref": "#/$defs/CountGlobalLeaderV1"
            },
            {
              "$ref": "#/$defs/AverageGlobalLeaderV1"
            },
            {
              "$ref": "#/$defs/OverallGlobalLeaderV1"
            }
          ],
          "items": false
        }
      }
    },
    "PersonalSummaryV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "partnerCount",
        "leaders"
      ],
      "properties": {
        "partnerCount": {
          "$ref": "#/$defs/JsonSafeNonNegativeIntegerV1"
        },
        "leaders": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "prefixItems": [
            {
              "$ref": "#/$defs/CountPersonalLeaderV1"
            },
            {
              "$ref": "#/$defs/AveragePersonalLeaderV1"
            },
            {
              "$ref": "#/$defs/OverallPersonalLeaderV1"
            },
            {
              "$ref": "#/$defs/PreferencePersonalLeaderV1"
            }
          ],
          "items": false
        }
      }
    },
    "GlobalDataV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "workUnit",
        "source",
        "summary",
        "items"
      ],
      "properties": {
        "workUnit": {
          "type": "string",
          "enum": [
            "subject",
            "series"
          ]
        },
        "source": {
          "$ref": "#/$defs/SourceV1"
        },
        "summary": {
          "$ref": "#/$defs/GlobalSummaryV1"
        },
        "items": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "$ref": "#/$defs/GlobalPartnerItemV1"
          }
        }
      }
    },
    "PersonalDataV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "workUnit",
        "source",
        "summary",
        "items"
      ],
      "properties": {
        "workUnit": {
          "type": "string",
          "enum": [
            "subject",
            "series"
          ]
        },
        "source": {
          "$ref": "#/$defs/SourceV1"
        },
        "summary": {
          "$ref": "#/$defs/PersonalSummaryV1"
        },
        "items": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "$ref": "#/$defs/PersonalPartnerItemV1"
          }
        }
      }
    },
    "PaginationV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "page",
        "pageSize",
        "total"
      ],
      "properties": {
        "page": {
          "$ref": "#/$defs/JsonSafePositiveIntegerV1"
        },
        "pageSize": {
          "type": "integer",
          "enum": [
            5,
            10,
            20
          ]
        },
        "total": {
          "$ref": "#/$defs/JsonSafeNonNegativeIntegerV1"
        }
      }
    },
    "CollectionMetaV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fetchedAt",
        "stale",
        "warningCodes"
      ],
      "properties": {
        "fetchedAt": {
          "type": "string",
          "format": "date-time"
        },
        "stale": {
          "type": "boolean"
        },
        "warningCodes": {
          "type": "array",
          "maxItems": 1,
          "uniqueItems": true,
          "items": {
            "const": "COLLECTION_STALE"
          }
        }
      }
    },
    "GlobalMetaV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requestId",
        "dataVersion",
        "pagination"
      ],
      "properties": {
        "requestId": {
          "$ref": "#/$defs/OpaqueIdentifierV1"
        },
        "dataVersion": {
          "$ref": "#/$defs/DataVersionV1"
        },
        "pagination": {
          "$ref": "#/$defs/PaginationV1"
        }
      }
    },
    "PersonalMetaV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requestId",
        "dataVersion",
        "pagination",
        "collection"
      ],
      "properties": {
        "requestId": {
          "$ref": "#/$defs/OpaqueIdentifierV1"
        },
        "dataVersion": {
          "$ref": "#/$defs/DataVersionV1"
        },
        "pagination": {
          "$ref": "#/$defs/PaginationV1"
        },
        "collection": {
          "$ref": "#/$defs/CollectionMetaV1"
        }
      }
    },
    "GlobalPartnersSuccessEnvelopeV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "data",
        "meta"
      ],
      "properties": {
        "data": {
          "$ref": "#/$defs/GlobalDataV1"
        },
        "meta": {
          "$ref": "#/$defs/GlobalMetaV1"
        }
      }
    },
    "PersonalPartnersSuccessEnvelopeV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "data",
        "meta"
      ],
      "properties": {
        "data": {
          "$ref": "#/$defs/PersonalDataV1"
        },
        "meta": {
          "$ref": "#/$defs/PersonalMetaV1"
        }
      }
    }
  }
}
