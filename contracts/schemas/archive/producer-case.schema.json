{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bangumi-staff-stats.invalid/schemas/archive/producer-case-v1.json",
  "title": "Archive producer golden case v1",
  "description": "Strict compact synthetic seven-source producer input, semantic identity, logical projection, accounting, and first stable outcome.",
