  "additionalProperties": false,
  "required": [
    "caseSchemaVersion",
    "caseId",
    "caseKind",
    "description",
    "inputs",
    "dataVersion",
    "expected",
    "equivalence"
  ],
  "properties": {
    "caseSchemaVersion": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1,
      "const": 1
    },
    "caseId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 96,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "caseKind": {
      "type": "string",
      "minLength": 1,
      "maxLength": 48,
      "enum": [
        "valid-seven-source",
        "identical-regeneration",
        "identical-duplicate",
        "permitted-unresolved-position",
        "malformed-record",
        "unknown-field-record",
        "conflicting-duplicate",
        "missing-reference",
        "missing-source",
        "extra-source",
        "digest-mismatch",
        "size-mismatch",
        "invalid-subject-type",
        "invalid-cast-role",
        "invalid-relation-code"
      ]
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "inputs": {
      "$ref": "#/$defs/inputs"
    },
    "dataVersion": {
      "$ref": "#/$defs/dataVersion"
    },
    "expected": {
      "$ref": "#/$defs/expected"
    },
    "equivalence": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "caseId",
            "sameDataVersion",
            "sameLogicalProjection"
          ],
          "properties": {
            "caseId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 96,
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
            },
            "sameDataVersion": {
              "type": "boolean"
            },
            "sameLogicalProjection": {
              "type": "boolean"
            }
          }
        }
      ]
    }
