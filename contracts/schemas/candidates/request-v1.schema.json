{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bangumi-staff-stats.local/schemas/candidates/request-v1.schema.json",
  "title": "CandidatesRequestV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "query",
    "input"
  ],
  "properties": {
    "query": {
      "$ref": "../query/shared-query-v1.schema.json#/$defs/OperationSharedQueryV1"
    },
    "input": {
      "$ref": "../query/operation-components-v1.schema.json#/$defs/CandidatesInputV1"
    },
    "view": {
      "$ref": "../query/operation-components-v1.schema.json#/$defs/CandidatesViewV1"
    }
  },
  "allOf": [
    {
      "if": {
        "type": "object",
        "properties": {
          "input": {
            "type": "object",
            "required": [
              "positionScope"
            ],
            "properties": {
              "positionScope": {
                "const": "all"
              }
            }
          }
        }
      },
      "then": {},
      "else": {
        "type": "object",
        "properties": {
          "query": {
            "$ref": "../query/shared-query-v1.schema.json"
          }
        }
      }
    }
  ]
}
