{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bangumi-staff-stats.local/schemas/candidates/success-envelope-v1.schema.json",
  "title": "CandidatesSuccessEnvelopeV1",
  "oneOf": [
    {
      "$ref": "#/$defs/PersonalCandidatesSuccessEnvelopeV1"
    },
    {
      "$ref": "#/$defs/GlobalCandidatesSuccessEnvelopeV1"
    }
  ],
  "$defs": {
    "JsonSafeNonNegativeIntegerV1": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "JsonSafePositiveIntegerV1": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "OpaqueIdentifierV1": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[^\\u0000-\\u001F\\u007F]+$"
    },
    "DataVersionV1": {
      "type": "string",
      "minLength": 68,
      "maxLength": 68,
      "pattern": "^dv1-[0-9a-f]{64}$"
    },
    "PositionKeyV1": {
      "$ref": "../query/shared-query-v1.schema.json#/$defs/PositionKeyV1"
    },
    "PersonReferenceV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "nameCN"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/JsonSafePositiveIntegerV1"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "nameCN": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 4096
        }
      }
    },
    "PositionCountV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "positionKey",
        "count"
      ],
      "properties": {
        "positionKey": {
          "$ref": "#/$defs/PositionKeyV1"
        },
        "count": {
          "$ref": "#/$defs/JsonSafeNonNegativeIntegerV1"
        }
      }
    },
    "CandidatesSummaryV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "positionCounts"
      ],
      "properties": {
        "positionCounts": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": {
            "$ref": "#/$defs/PositionCountV1"
          }
        }
      }
    },
    "CandidateItemV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rank",
        "person",
        "workCount"
      ],
      "properties": {
        "rank": {
          "$ref": "#/$defs/JsonSafePositiveIntegerV1"
        },
        "person": {
          "$ref": "#/$defs/PersonReferenceV1"
        },
        "workCount": {
          "$ref": "#/$defs/JsonSafeNonNegativeIntegerV1"
        }
      }
    },
    "CandidatesDataV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "summary",
        "positionKey",
        "workUnit",
        "items"
      ],
      "properties": {
        "summary": {
          "$ref": "#/$defs/CandidatesSummaryV1"
        },
        "positionKey": {
          "$ref": "#/$defs/PositionKeyV1"
        },
        "workUnit": {
          "type": "string",
          "enum": [
            "subject",
            "series"
          ]
        },
        "items": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "$ref": "#/$defs/CandidateItemV1"
          }
        }
      }
    },
    "PaginationV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "page",
        "pageSize",
        "total"
      ],
      "properties": {
        "page": {
          "$ref": "#/$defs/JsonSafePositiveIntegerV1"
        },
        "pageSize": {
          "type": "integer",
          "enum": [
            5,
            10,
            20
          ]
        },
        "total": {
          "$ref": "#/$defs/JsonSafeNonNegativeIntegerV1"
        }
      }
    },
    "CollectionMetaV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fetchedAt",
        "stale",
        "warningCodes"
      ],
      "properties": {
        "fetchedAt": {
          "type": "string",
          "format": "date-time"
        },
        "stale": {
          "type": "boolean"
        },
        "warningCodes": {
          "type": "array",
          "maxItems": 1,
          "uniqueItems": true,
          "items": {
            "const": "COLLECTION_STALE"
          }
        }
      }
    },
    "GlobalMetaV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requestId",
        "dataVersion",
        "pagination"
      ],
      "properties": {
        "requestId": {
          "$ref": "#/$defs/OpaqueIdentifierV1"
        },
        "dataVersion": {
          "$ref": "#/$defs/DataVersionV1"
        },
        "pagination": {
          "$ref": "#/$defs/PaginationV1"
        }
      }
    },
    "PersonalMetaV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requestId",
        "dataVersion",
        "pagination",
        "collection"
      ],
      "properties": {
        "requestId": {
          "$ref": "#/$defs/OpaqueIdentifierV1"
        },
        "dataVersion": {
          "$ref": "#/$defs/DataVersionV1"
        },
        "pagination": {
          "$ref": "#/$defs/PaginationV1"
        },
        "collection": {
          "$ref": "#/$defs/CollectionMetaV1"
        }
      }
    },
    "GlobalCandidatesSuccessEnvelopeV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "data",
        "meta"
      ],
      "properties": {
        "data": {
          "$ref": "#/$defs/CandidatesDataV1"
        },
        "meta": {
          "$ref": "#/$defs/GlobalMetaV1"
        }
      }
    },
    "PersonalCandidatesSuccessEnvelopeV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "data",
        "meta"
      ],
      "properties": {
        "data": {
          "$ref": "#/$defs/CandidatesDataV1"
        },
        "meta": {
          "$ref": "#/$defs/PersonalMetaV1"
        }
      }
    }
  }
}
