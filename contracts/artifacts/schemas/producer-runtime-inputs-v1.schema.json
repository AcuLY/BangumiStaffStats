{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/AcuLY/BangumiStaffStats/contracts/artifacts/producer-runtime-inputs-v1.schema.json",
  "title": "Bangumi Staff Statistics producer runtime inputs manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "fileCount",
    "totalSize",
    "files",
    "fileSetDigest"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "fileCount": {
      "const": 42
    },
    "totalSize": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "files": {
      "type": "array",
      "minItems": 42,
      "maxItems": 42,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/file"
      }
    },
    "fileSetDigest": {
      "$ref": "#/$defs/digest"
    }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "pattern": "^(?!.*(?:^|/)\\.{1,2}(?:/|$))[A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+)*$"
    },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "size", "sha256"],
      "properties": {
        "path": {
          "$ref": "#/$defs/path"
        },
        "size": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "sha256": {
          "$ref": "#/$defs/digest"
        }
      }
    }
  }
}
